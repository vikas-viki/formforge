// use https://prismaliser.app/ for visualizing the schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LOCAL_DATABASE_URL")
}

enum UserType {
  ADMIN
  USER
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationType {
  STUDY_CERTIFICATE
  TRANSFER_CERTIFICATE
  MID_DAY_MEAL
  CONVEYANCE
}

model User {
  userId       String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(100)
  password     String        @db.VarChar(150)
  type         UserType      @default(USER)
  createdAt    DateTime      @default(now())
  name         String        @default("John")
  profile      Profile?
  applications Application[]
}

model Profile {
  id          String @id @default(uuid())
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [userId])
  name        String @default("")
  rollNo      String @default("")
  course      String @default("")
  semister    String @default("")
  passingYear Int    @default(0)
  email       String
}

model Application {
  applicationId String              @id @default(uuid())
  user          User                @relation(fields: [userId], references: [userId])
  userId        String              @db.Uuid
  type          ApplicationType
  status        Status              @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now())
  details       ApplicationDetails?
  reason        String?
}

model ApplicationDetails {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [applicationId])
  name          String
  course        String?
  rollNo        String?
  semester      String?
  staffId       String?
  leaveDate     DateTime?
  returnDate    DateTime?
  reason        String?
  passingYear   Int?
  description   String?
}
